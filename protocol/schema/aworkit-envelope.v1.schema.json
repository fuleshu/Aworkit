{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aworkit.local/schema/aworkit-envelope.v1.schema.json",
  "title": "Aworkit Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "generation", "kind", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "messageId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "generation": { "type": "integer", "minimum": 0 },
    "kind": { "enum": ["command", "event", "request", "result", "error"] },
    "payload": { "type": "object" }
  }
}
