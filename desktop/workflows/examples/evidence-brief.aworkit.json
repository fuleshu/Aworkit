      "label": "Evidence needed?",
      "type": "condition",
      "position": {
        "x": 710,
        "y": 410
      },
      "configuration": {
        "predicate": {
          "kind": "exists",
          "path": "evidenceNeeded.0"
        }
      }
    },
    {
