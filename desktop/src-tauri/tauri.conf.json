{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aworkit",
  "version": "0.1.0",
  "identifier": "com.aworkit.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": null,
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aworkit",
        "width": 1440,
        "height": 940,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../skills/": "skills/",
      "../workflows/examples/": "workflows/examples/",
      "../tool-plugins/ffmpeg/tool-plugin.json": "tool-plugins/ffmpeg/tool-plugin.json",
      "../tool-plugins/ffmpeg/ffmpeg_bridge.py": "tool-plugins/ffmpeg/ffmpeg_bridge.py",
      "../tool-plugins/ffmpeg/test_ffmpeg_bridge.py": "tool-plugins/ffmpeg/test_ffmpeg_bridge.py",
      "../tool-plugins/ffmpeg/README.md": "tool-plugins/ffmpeg/README.md",
      "../tool-plugins/ffmpeg/skills/": "tool-plugins/ffmpeg/skills/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
